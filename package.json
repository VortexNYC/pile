{
  "name": "pile",
  "version": "0.1.1",
  "description": "Pile — an open-source, agent-native issue tracker on Cloudflare Workers.",
  "keywords": [
    "agent",
    "cloudflare",
    "devin",
    "issue-tracker",
    "linear",
    "vortex",
    "worker"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "vp exec wrangler deploy -e production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/capture && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/widget",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "mcp:generate": "tsx scripts/generate-openapi.ts && tsx scripts/generate-mcp-tools.ts",
    "client:generate": "openapi-typescript src/mcp/openapi.json -o packages/cli/src/client/types.ts",
    "cli:generate": "tsx scripts/generate-cli.ts",
    "capture:bundle": "pnpm -C packages/capture run build && node -e \"const fs=require('fs');fs.writeFileSync('src/assets/capture.iife.ts','export default '+JSON.stringify(fs.readFileSync('packages/capture/dist/capture.iife.js','utf8'))+'\\n')\"",
    "chat:bundle": "pnpm -C packages/widget run build && node -e \"const fs=require('fs');fs.writeFileSync('src/assets/chat.iife.ts','export default '+JSON.stringify(fs.readFileSync('packages/widget/dist/chat.iife.js','utf8'))+'\\n')\"",
    "cli": "pnpm -C packages/cli run cli",
    "contract:check": "tsx scripts/contract-check.ts",
    "diff-coverage": "tsx scripts/diff-coverage.ts",
    "knip": "knip",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "build:packages": "pnpm --filter @vortex-api/pile build",
    "selfhost": "bash scripts/selfhost.sh",
    "seed:local": "tsx scripts/seed-local.ts",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "entire:review": "entire review",
    "entire:investigate": "entire investigate",
    "entire:why": "entire why",
    "entire:blame": "entire blame",
    "entire:experts": "entire experts",
    "entire:tokens": "entire tokens",
    "entire:tokens:profile": "entire tokens profile",
    "docs:bundle": "tsx scripts/generate-docs-bundle.ts",
    "runner:bundle": "tsx scripts/generate-runner-bundle.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/scim": "1.7.7",
    "@better-auth/sso": "1.7.7",
    "@chat-adapter/slack": "^4.41.1",
    "@cloudflare/sandbox": "1.0.0",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "@orama/orama": "3.1.18",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "better-auth": "^1.7.7",
    "chat": "^4.41.1",
    "drizzle-orm": "^0.45.3",
    "emoji-regex": "11.0.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "mimetext": "^3.0.28",
    "postal-mime": "2.7.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "5.20261003.1",
    "@pile/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.39.0",
    "openapi-typescript": "^7.13.0",
    "samlify": "2.13.1",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "~4.147.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.5.0"
    }
  }
}
