{
  "name": "pile",
  "version": "0.1.1",
  "description": "Pile — an open-source, agent-native issue tracker on Cloudflare Workers.",
  "keywords": [
    "agent",
    "cloudflare",
    "devin",
    "issue-tracker",
    "linear",
    "vortex",
    "worker"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run web:build && wrangler dev",
    "deploy": "pnpm run web:build && vp exec wrangler deploy -e production",
    "web:build": "pnpm -C apps/web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/capture && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/widget && tsc --noEmit -p apps/web",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "mcp:generate": "tsx scripts/generate-openapi.ts && tsx scripts/generate-mcp-tools.ts",
    "client:generate": "openapi-typescript src/mcp/openapi.json -o packages/cli/src/client/types.ts",
    "cli:generate": "tsx scripts/generate-cli.ts",
    "capture:bundle": "pnpm -C packages/capture run build && node -e \"const fs=require('fs');fs.writeFileSync('src/assets/capture.iife.ts','export default '+JSON.stringify(fs.readFileSync('packages/capture/dist/capture.iife.js','utf8'))+'\\n')\"",
    "chat:bundle": "pnpm -C packages/widget run build && node -e \"const fs=require('fs');fs.writeFileSync('src/assets/chat.iife.ts','export default '+JSON.stringify(fs.readFileSync('packages/widget/dist/chat.iife.js','utf8'))+'\\n')\"",
    "cli": "pnpm -C packages/cli run cli",
    "contract:check": "tsx scripts/contract-check.ts",
    "diff-coverage": "tsx scripts/diff-coverage.ts",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "build:packages": "pnpm --filter @vortex-api/pile build",
    "selfhost": "bash scripts/selfhost.sh",
    "seed:local": "tsx scripts/seed-local.ts",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "docs:bundle": "tsx scripts/generate-docs-bundle.ts",
    "runner:bundle": "tsx scripts/generate-runner-bundle.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.18",
    "@better-auth/scim": "1.7.18",
    "@better-auth/sso": "1.7.18",
    "@chat-adapter/slack": "^4.44.0",
    "@cloudflare/sandbox": "0.12.10",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "better-auth": "^1.7.18",
    "chat": "^4.44.0",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.2",
    "emoji-regex": "11.0.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "mimetext": "^3.0.28",
    "postal-mime": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sandbox-1": "npm:@cloudflare/sandbox@1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@pile/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.44.1",
    "openapi-typescript": "^7.13.0",
    "samlify": "2.15.1",
    "secretlint": "^13.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vite-plus": "^1.5.0",
    "vitest": "^4.1.11",
    "wrangler": "~4.158.0"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.5.0",
      "samlify": "2.15.1"
    }
  }
}
