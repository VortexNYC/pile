{
  "name": "issuetracker",
  "version": "0.1.0",
  "description": "Vortex Issue Tracker — an open-source, agent-native issue tracker on Cloudflare Workers.",
  "keywords": [
    "agent",
    "cloudflare",
    "devin",
    "issue-tracker",
    "linear",
    "vortex",
    "worker"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "mcp:generate": "tsx scripts/generate-openapi.ts && tsx scripts/generate-mcp-tools.ts",
    "client:generate": "openapi-typescript src/mcp/openapi.json -o packages/client/src/types.ts",
    "cli": "pnpm -C packages/cli run cli",
    "contract:check": "tsx scripts/contract-check.ts",
    "knip": "knip",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "pnpm run contract:check && vp check && pnpm test"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.5.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "5.20260730.1",
    "@issuetracker/tsconfig": "workspace:*",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "~4.116.0"
  }
}
