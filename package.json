{
  "name": "pile",
  "version": "0.1.1",
  "description": "Pile — an open-source, agent-native issue tracker on Cloudflare Workers.",
  "keywords": [
    "agent",
    "cloudflare",
    "devin",
    "issue-tracker",
    "linear",
    "vortex",
    "worker"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "vp exec wrangler deploy -e production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "mcp:generate": "tsx scripts/generate-openapi.ts && tsx scripts/generate-mcp-tools.ts",
    "client:generate": "openapi-typescript src/mcp/openapi.json -o packages/cli/src/client/types.ts",
    "cli:generate": "tsx scripts/generate-cli.ts",
    "cli": "pnpm -C packages/cli run cli",
    "contract:check": "tsx scripts/contract-check.ts",
    "knip": "knip",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "build:packages": "pnpm --filter @vortex-api/pile build",
    "selfhost": "bash scripts/selfhost.sh",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "entire:review": "entire review",
    "entire:investigate": "entire investigate",
    "entire:why": "entire why",
    "entire:blame": "entire blame",
    "entire:experts": "entire experts",
    "entire:tokens": "entire tokens",
    "entire:tokens:profile": "entire tokens profile"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.2",
    "@chat-adapter/slack": "^4.40.0",
    "@cloudflare/sandbox": "0.12.9",
    "@hono/zod-openapi": "1.6.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@orama/orama": "3.1.18",
    "better-auth": "^1.7.2",
    "chat": "^4.40.0",
    "drizzle-orm": "^0.45.2",
    "emoji-regex": "10.6.0",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "postal-mime": "2.7.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "5.20260730.1",
    "@pile/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.34.0",
    "openapi-typescript": "^7.13.0",
    "secretlint": "^13.0.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "~4.129.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run scan:secrets"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.5.0"
    }
  }
}
