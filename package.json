{
  "name": "issuetracker",
  "version": "0.1.0",
  "description": "Vortex Issue Tracker — an open-source, agent-native issue tracker on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
