{
  "name": "notion-engineering-queue",
  "version": "0.1.0",
  "description": "A Notion-backed engineering queue that dispatches work to Devin (or any SWE agent) and writes results back. Linear-style issue tracking inside Notion.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "keywords": [
    "notion",
    "devin",
    "linear",
    "engineering",
    "queue",
    "worker",
    "cloudflare"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.78.0"
  }
}
