{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/consolidate-linear-import.ts"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "e2e/**/*.ts"]
    },
    "packages/docs": {
      "entry": ["blume.config.ts", "docs/**/meta.ts"]
    }
  },
  "ignore": ["packages/cli/src/client/types.ts", "packages/clipper/**"],
  "ignoreDependencies": [
    "cloudflare",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "ignoreBinaries": ["entire", "mktemp"],
  "ignoreExportsUsedInFile": true
}
