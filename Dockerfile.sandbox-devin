FROM docker.io/cloudflare/sandbox:0.12.9

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Repo toolchain baked: agents routinely run `pnpm install`/`check`; without
# this they bootstrap pnpm via npm/corepack on every run (~2-5 min wasted).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate

ENV HOME=/root
# The devin installer exits non-zero when its interactive wizard bails
# without a TTY; verify the binary directly.
RUN mkdir -p /root/.local/bin \
    && (curl -fsSL https://cli.devin.ai/install.sh | bash || true) \
    && test -x /root/.local/bin/devin
ENV PATH="/root/.local/bin:${PATH}"
