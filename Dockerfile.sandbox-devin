FROM docker.io/cloudflare/sandbox:0.12.9

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 curl ca-certificates gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Postgres 16 from PGDG — debian stable ships 15, but lane targets (vortex)
# test against 16. The deb postinst already creates cluster `16/main`, so the
# runner's `pg_ctlcluster 16 main start` just starts it (ensure_postgres in
# src/agents/devin-cli.ts).
RUN install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16 \
    && rm -rf /var/lib/apt/lists/*

# Repo toolchain baked: agents routinely run `pnpm install`/`check`; without
# this they bootstrap pnpm via npm/corepack on every run. Node 24 and pnpm
# 11.13.1 match vortex's .nvmrc/packageManager — corepack still resolves the
# per-repo version for repos that pin something else.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.13.1 --activate

ENV HOME=/root

# NOTE: a baked pnpm store (prewarmed dep trees) pushed this image past the
# Workers Containers ~2GB size limit and instances would not start. Keep the
# image lean; lanes pay `pnpm install` cost per run.

# The devin installer exits non-zero when its interactive wizard bails
# without a TTY; verify the binary directly.
RUN mkdir -p /root/.local/bin \
    && (curl -fsSL https://cli.devin.ai/install.sh | bash || true) \
    && test -x /root/.local/bin/devin
ENV PATH="/root/.local/bin:${PATH}"
