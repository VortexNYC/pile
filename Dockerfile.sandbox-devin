FROM docker.io/cloudflare/sandbox:0.12.9

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 curl ca-certificates gnupg lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Postgres 16 from PGDG — debian stable ships 15, but lane targets (vortex)
# test against 16. The deb postinst already creates cluster `16/main`, so the
# runner's `pg_ctlcluster 16 main start` just starts it (ensure_postgres in
# src/agents/devin-cli.ts).
RUN install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-16 \
    && rm -rf /var/lib/apt/lists/*

# Repo toolchain baked: agents routinely run `pnpm install`/`check`; without
# this they bootstrap pnpm via npm/corepack on every run. Node 24 and pnpm
# 11.13.1 match vortex's .nvmrc/packageManager — corepack still resolves the
# per-repo version for repos that pin something else.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.13.1 --activate \
    && corepack prepare pnpm@9.15.4
# The base image ships node22 at /usr/local/bin — which precedes /usr/bin in
# PATH — so shadow it with the nodesource v24 binaries.
RUN for b in node npm npx corepack; do \
      [ -e "/usr/bin/$b" ] && ln -sf "/usr/bin/$b" "/usr/local/bin/$b"; \
    done \
    && node --version | grep -q '^v24'

# Optional headless browser (PILE-292): build with --build-arg LANE_BROWSER=1
# (wrangler: image_vars = { LANE_BROWSER = "1" }) to bake Google Chrome and
# agent-browser so UI-touching lanes can run e2e suites and screenshot their
# work. Off by default — it adds ~750MB (unpacked) against the Workers
# Containers ~2GB image limit. Ubuntu 22.04's chromium is snap-only, hence
# Google's .deb. The runner detects the binary and wires
# PILE_BROWSER/CHROME_PATH/AGENT_BROWSER_* into the agent env.
ARG LANE_BROWSER=0
RUN if [ "$LANE_BROWSER" = "1" ]; then \
      curl -fsSL https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
        -o /tmp/google-chrome.deb \
      && apt-get update \
      && apt-get install -y --no-install-recommends /tmp/google-chrome.deb fonts-liberation \
      && rm -rf /var/lib/apt/lists/* /tmp/google-chrome.deb \
      && npm install -g agent-browser@0.38.1 \
      && find "$(npm root -g)/agent-browser/bin" -name 'agent-browser-*' \
         ! -name 'agent-browser-linux-x64' -delete \
      && npm cache clean --force \
      && google-chrome-stable --version \
      && agent-browser --version; \
    fi

ENV HOME=/root

# NOTE: a baked pnpm store (prewarmed dep trees) pushed this image past the
# Workers Containers ~2GB size limit and instances would not start. Keep the
# image lean; lanes pay `pnpm install` cost per run.

# The devin installer exits non-zero when its interactive wizard bails
# without a TTY; verify the binary directly.
RUN mkdir -p /root/.local/bin \
    && (curl -fsSL https://cli.devin.ai/install.sh | bash || true) \
    && test -x /root/.local/bin/devin
ENV PATH="/root/.local/bin:${PATH}"
