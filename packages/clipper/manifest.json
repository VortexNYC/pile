{
  "manifest_version": 3,
  "name": "Pile Clipper",
  "version": "2.0.0",
  "description": "Capture pages to Pile with screenshots, summaries, and routing",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pile it"
  }
}
