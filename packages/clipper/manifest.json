{
  "manifest_version": 3,
  "name": "Pile Clipper",
  "version": "1.1.0",
  "description": "One-button capture to Pile",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pile it"
  }
}
