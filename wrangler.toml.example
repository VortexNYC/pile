name = "vortex-linear"
main = "src/index.ts"
compatibility_date = "2026-08-31"

[vars]
BETTER_AUTH_URL = "https://your-domain.com"
DEVIN_OUTPOST = "user:daytona-linux"
DEVIN_MODEL = "swe-1-7-medium"

[[d1_databases]]
binding = "D1"
database_name = "vortex-linear-global"
database_id = "<your-d1-database-id>"

[[durable_objects.bindings]]
name = "WORKSPACE_DURABLE_OBJECT"
class_name = "WorkspaceDO"

[[migrations]]
tag = "v1"
new_classes = ["WorkspaceDO"]
