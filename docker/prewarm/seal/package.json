{
  "name": "seal",
  "version": "0.0.1",
  "private": true,
  "description": "Seal — open-source, agent-native e-signature platform",
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev --filter @seal/api --filter @seal/web --filter @seal/docs",
    "dev:web": "pnpm --dir apps/web run dev -- --host 0.0.0.0",
    "dev:docs": "pnpm --dir apps/docs run dev",
    "dev:all": "pnpm run dev",
    "build": "pnpm --filter @seal/web run build",
    "build:all": "vp run -r build",
    "deploy": "vp run -F @seal/anydoc-worker deploy && vp run -F @seal/convert-worker deploy && vp run -F @seal/api deploy && vp run -F @seal/mcp-worker deploy && vp run -F @seal/web deploy && vp run -F @seal/site deploy",
    "test": "vp run -F @seal/api -F @seal/web test",
    "typecheck": "vp run -F @seal/api -F @seal/web -F @vortex-api/seal -F @seal/transactional -F @seal/convert-worker -F @seal/anydoc-worker -F @seal/mcp-worker -F @seal/internal-auth -F @seal/site typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "knip": "vp run -r knip",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "selfhost": "bash scripts/selfhost.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci:publish": "pnpm --filter @vortex-api/seal run build && changeset publish",
    "dogfood": "node scripts/dogfood-cli.mjs",
    "prove:golden-path": "node scripts/prove-golden-path.mjs",
    "prove:backup-dr": "node scripts/prove-backup-dr.mjs",
    "prove:secret-scan": "node scripts/prove-secret-scan.mjs",
    "prove:pdf-seal": "pnpm --dir apps/api exec tsx ./scripts/prove-pdf-seal.ts",
    "fix": "vp lint --fix && vp fmt",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "verify:clean": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip",
    "clean": "(cd apps/web && pnpm run clean) && git clean -xdf .cache dist node_modules",
    "prove:signer-contact-sheet": "node scripts/prove-signer-contact-sheet.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@seal/tsconfig": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@shadcn/lint": "^0.1.0",
    "knip": "^6.35.1",
    "secretlint": "^13.0.5",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite-plus": "0.3.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run scan:secrets"
  },
  "packageManager": "pnpm@12.4.2"
}
